# OGYMED · Variables de entorno. Copiar a .env.local (desarrollo) o configurar en Vercel.
# NUNCA versionar valores reales. Sólo las NEXT_PUBLIC_* llegan al navegador.

# URL canónica del sitio (dominio final en producción, sin barra final).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: URL del proyecto y publishable key (pública; el acceso lo limita RLS).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (Si conectas Supabase desde el Marketplace de Vercel, también sirven sus nombres
#  NEXT_PUBLIC_SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY.)

# Supabase secret key (antes service_role). SÓLO servidor. Elude RLS: el código la usa únicamente
# para ejecutar funciones SQL de reserva/autogestión/cron e invitaciones de personal.
SUPABASE_SECRET_KEY=

# Pimienta para HMAC de códigos de verificación e IPs (≥32 caracteres aleatorios, p. ej. `openssl rand -base64 48`).
BOOKING_CODE_PEPPER=

# Secreto de Vercel Cron (≥32 caracteres). Vercel lo envía como `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Correo transaccional (Resend). Sin estas variables en producción, el envío queda deshabilitado
# y las reservas web no se pueden verificar (se mostrará «Solicitar cita»).
RESEND_API_KEY=
EMAIL_FROM="OGYMED <citas@dominio-por-confirmar>"
EMAIL_REPLY_TO=
# resend | dev-file | disabled  (dev-file sólo en desarrollo: escribe en .dev-mail/)
EMAIL_TRANSPORT=

# Indexación: sólo `on` en el despliegue de producción con dominio final.
SITE_INDEXING=off
# Forzar entorno fuera de Vercel: development | preview | production
APP_ENV=
